{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oran-aic:schema:integration-values:1.0.0",
  "title": "O-RAN AIC final-merge integration values",
  "description": "The only non-source inputs that may differ between the independently built upper and lower releases. Secret values are forbidden; only secret references are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractProfile",
    "deploymentMode",
    "bundleManifestJcsSha256",
    "values"
  ],
  "properties": {
    "schemaVersion": { "const": "oran-aic-integration-values/1.0.0" },
    "contractProfile": { "const": "oran-aic/1.0.0" },
    "deploymentMode": { "const": "MERGED" },
    "bundleManifestJcsSha256": { "$ref": "#/$defs/Sha256" },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment.testVectorPath",
        "deployment.testVectorSha256",
        "backend.capabilityManifestPath",
        "backend.capabilityManifestSha256",
        "backend.releaseManifestPath",
        "backend.releaseManifestSha256",
        "backend.e2CapabilityInventoryPath",
        "backend.e2CapabilityInventorySha256",
        "r1.apiRoot",
        "r1.rAppId",
        "r1.dme.policyEvidencePushBaseUri",
        "r1.https.truststoreRef",
        "r1.https.clientCertificateRef",
        "r1.https.clientPrivateKeyRef",
        "r1.https.oauthClientId",
        "r1.https.oauthCredentialRef",
        "r1.https.oauthTokenEndpoint",
        "r1.https.oauthAudience",
        "r1.https.oauthScope",
        "r1.https.pushServerCertificateRef",
        "r1.https.pushServerPrivateKeyRef",
        "r1.https.pushProducerClientCertificateRef",
        "r1.https.pushProducerClientPrivateKeyRef",
        "r1.https.pushProducerOauthClientId",
        "r1.https.pushProducerOauthCredentialRef",
        "r1.https.pushProducerOauthTokenEndpoint",
        "r1.https.pushProducerOauthAudience",
        "r1.https.pushProducerOauthScope",
        "a1.apiRoot",
        "a1.notificationDestination",
        "a1.https.truststoreRef",
        "a1.https.consumerClientCertificateRef",
        "a1.https.consumerClientPrivateKeyRef",
        "a1.https.consumerOauthClientId",
        "a1.https.consumerOauthCredentialRef",
        "a1.https.consumerOauthTokenEndpoint",
        "a1.https.consumerOauthAudience",
        "a1.https.consumerOauthScope",
        "a1.https.notificationSenderClientCertificateRef",
        "a1.https.notificationSenderClientPrivateKeyRef",
        "a1.https.notificationSenderOauthClientId",
        "a1.https.notificationSenderOauthCredentialRef",
        "a1.https.notificationSenderOauthTokenEndpoint",
        "a1.https.notificationSenderOauthAudience",
        "a1.https.notificationSenderOauthScope",
        "a1.https.producerServerCertificateRef",
        "a1.https.producerServerPrivateKeyRef",
        "a1.https.notificationReceiverServerCertificateRef",
        "a1.https.notificationReceiverServerPrivateKeyRef",
        "o1.netconf.endpoint",
        "o1.netconf.knownHostsRef",
        "o1.netconf.credentialRef",
        "o1.fileDataReporting.mnsRoot",
        "o1.fileDataReporting.mnsVersion",
        "o1.fileDataReporting.mnsAgentDn",
        "o1.fileDataReporting.consumerReference",
        "o1.sftp.allowedAuthorities",
        "o1.sftp.knownHostsRef",
        "o1.sftp.credentialRef",
        "o1.perfMetricJob.managedObjectDn",
        "o1.perfMetricJob.managedObjectUri",
        "o1.https.truststoreRef",
        "o1.https.consumerClientCertificateRef",
        "o1.https.consumerClientPrivateKeyRef",
        "o1.https.consumerOauthClientId",
        "o1.https.consumerOauthCredentialRef",
        "o1.https.consumerOauthTokenEndpoint",
        "o1.https.consumerOauthAudience",
        "o1.https.consumerOauthScope",
        "o1.https.notificationSenderClientCertificateRef",
        "o1.https.notificationSenderClientPrivateKeyRef",
        "o1.https.notificationSenderOauthClientId",
        "o1.https.notificationSenderOauthCredentialRef",
        "o1.https.notificationSenderOauthTokenEndpoint",
        "o1.https.notificationSenderOauthAudience",
        "o1.https.notificationSenderOauthScope",
        "o1.https.providerServerCertificateRef",
        "o1.https.providerServerPrivateKeyRef",
        "o1.https.notificationReceiverServerCertificateRef",
        "o1.https.notificationReceiverServerPrivateKeyRef"
      ],
      "properties": {
        "deployment.testVectorPath": { "$ref": "#/$defs/ArtifactPath" },
        "deployment.testVectorSha256": { "$ref": "#/$defs/Sha256" },
        "backend.capabilityManifestPath": { "$ref": "#/$defs/ArtifactPath" },
        "backend.capabilityManifestSha256": { "$ref": "#/$defs/Sha256" },
        "backend.releaseManifestPath": { "$ref": "#/$defs/ArtifactPath" },
        "backend.releaseManifestSha256": { "$ref": "#/$defs/Sha256" },
        "backend.e2CapabilityInventoryPath": { "$ref": "#/$defs/ArtifactPath" },
        "backend.e2CapabilityInventorySha256": { "$ref": "#/$defs/Sha256" },
        "r1.apiRoot": { "$ref": "#/$defs/HttpsBase" },
        "r1.rAppId": { "$ref": "#/$defs/Identifier" },
        "r1.dme.policyEvidencePushBaseUri": { "$ref": "#/$defs/HttpsBase" },
        "r1.https.truststoreRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.clientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.clientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.oauthClientId": { "$ref": "#/$defs/Identifier" },
        "r1.https.oauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.oauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "r1.https.oauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "r1.https.oauthScope": { "$ref": "#/$defs/NonEmpty" },
        "r1.https.pushServerCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.pushServerPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.pushProducerClientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.pushProducerClientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.pushProducerOauthClientId": { "$ref": "#/$defs/Identifier" },
        "r1.https.pushProducerOauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "r1.https.pushProducerOauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "r1.https.pushProducerOauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "r1.https.pushProducerOauthScope": { "$ref": "#/$defs/NonEmpty" },
        "a1.apiRoot": { "$ref": "#/$defs/HttpsBase" },
        "a1.notificationDestination": { "$ref": "#/$defs/HttpsBase" },
        "a1.https.truststoreRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.consumerClientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.consumerClientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.consumerOauthClientId": { "$ref": "#/$defs/Identifier" },
        "a1.https.consumerOauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.consumerOauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "a1.https.consumerOauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "a1.https.consumerOauthScope": { "$ref": "#/$defs/NonEmpty" },
        "a1.https.notificationSenderClientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.notificationSenderClientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.notificationSenderOauthClientId": { "$ref": "#/$defs/Identifier" },
        "a1.https.notificationSenderOauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.notificationSenderOauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "a1.https.notificationSenderOauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "a1.https.notificationSenderOauthScope": { "$ref": "#/$defs/NonEmpty" },
        "a1.https.producerServerCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.producerServerPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.notificationReceiverServerCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "a1.https.notificationReceiverServerPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "o1.netconf.endpoint": { "$ref": "#/$defs/NetconfSshUri" },
        "o1.netconf.knownHostsRef": { "$ref": "#/$defs/SecretReference" },
        "o1.netconf.credentialRef": { "$ref": "#/$defs/SecretReference" },
        "o1.fileDataReporting.mnsRoot": { "$ref": "#/$defs/HttpsBase" },
        "o1.fileDataReporting.mnsVersion": { "type": "string", "pattern": "^v[0-9]+(?:[._-][A-Za-z0-9]+)*$" },
        "o1.fileDataReporting.mnsAgentDn": { "$ref": "#/$defs/DistinguishedName" },
        "o1.fileDataReporting.consumerReference": { "$ref": "#/$defs/HttpsBase" },
        "o1.sftp.allowedAuthorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
          }
        },
        "o1.sftp.knownHostsRef": { "$ref": "#/$defs/SecretReference" },
        "o1.sftp.credentialRef": { "$ref": "#/$defs/SecretReference" },
        "o1.perfMetricJob.managedObjectDn": { "$ref": "#/$defs/DistinguishedName" },
        "o1.perfMetricJob.managedObjectUri": { "$ref": "#/$defs/HttpsUri" },
        "o1.https.truststoreRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.consumerClientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.consumerClientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.consumerOauthClientId": { "$ref": "#/$defs/Identifier" },
        "o1.https.consumerOauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.consumerOauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "o1.https.consumerOauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "o1.https.consumerOauthScope": { "$ref": "#/$defs/NonEmpty" },
        "o1.https.notificationSenderClientCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.notificationSenderClientPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.notificationSenderOauthClientId": { "$ref": "#/$defs/Identifier" },
        "o1.https.notificationSenderOauthCredentialRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.notificationSenderOauthTokenEndpoint": { "$ref": "#/$defs/HttpsUri" },
        "o1.https.notificationSenderOauthAudience": { "$ref": "#/$defs/NonEmpty" },
        "o1.https.notificationSenderOauthScope": { "$ref": "#/$defs/NonEmpty" },
        "o1.https.providerServerCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.providerServerPrivateKeyRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.notificationReceiverServerCertificateRef": { "$ref": "#/$defs/SecretReference" },
        "o1.https.notificationReceiverServerPrivateKeyRef": { "$ref": "#/$defs/SecretReference" }
      }
    }
  },
  "$defs": {
    "Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ArtifactPath": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "NonEmpty": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "DistinguishedName": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[^=,]+=[^,]+(?:,[^=,]+=[^,]+)*$" },
    "HttpsUri": { "type": "string", "format": "uri", "pattern": "^https://[^\\s]+$" },
    "HttpsBase": { "type": "string", "format": "uri", "pattern": "^https://[^\\s/]+(?:/[^\\s/]*)*$" },
    "NetconfSshUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^ssh://[^\\s/:]+(?::(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "SecretReference": {
      "type": "string",
      "minLength": 7,
      "maxLength": 4096,
      "pattern": "^(?:env|file|vault|k8s|keychain)://[^\\s]+$",
      "not": { "pattern": "-----BEGIN|password=|secret=" }
    }
  }
}
