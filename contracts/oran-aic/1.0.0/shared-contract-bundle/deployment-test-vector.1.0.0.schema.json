{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oran-aic:schema:deployment-test-vector:1.0.0",
  "title": "O-RAN AIC Conformance Deployment Test Vector",
  "description": "Non-secret, deployment-specific inputs required to execute the normative scenario catalog without out-of-band communication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["vectorVersion", "r1", "a1", "o1", "e2Inventory", "topology", "policy", "security", "timeouts", "schemas"],
  "properties": {
    "vectorVersion": {"const": "oran-aic-deployment-test-vector/1.0.0"},
    "r1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiRoot", "rAppId", "publishesGeneralRequestResponseApi", "callbackApi", "statusSubscriptionId", "dme"],
      "properties": {
        "apiRoot": {"$ref": "#/$defs/httpsUri"},
        "rAppId": {"$ref": "#/$defs/nonEmptyId"},
        "publishesGeneralRequestResponseApi": {
          "type": "boolean",
          "description": "True only when this rApp intentionally publishes a general request-response R1 service API. Onboarding identity, service consumption and DME push callback do not make this true."
        },
        "statusSubscriptionId": {"$ref": "#/$defs/nonEmptyId"},
        "callbackApi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiName", "aefId", "rootUri", "ipv4Addr", "port", "resourceUri"],
          "properties": {
            "apiName": {"type": "string", "minLength": 1, "maxLength": 255},
            "aefId": {"$ref": "#/$defs/nonEmptyId"},
            "rootUri": {"$ref": "#/$defs/httpsUri"},
            "ipv4Addr": {"type": "string", "format": "ipv4"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "resourceUri": {"type": "string", "pattern": "^/[^?#]*$"}
          }
        },
        "dme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policyEvidencePushBaseUri", "activeDataJobId", "activeDeliveryBindingId", "dataAccessEndpoint"],
          "properties": {
            "policyEvidencePushBaseUri": {"$ref": "#/$defs/httpsUri"},
            "activeDataJobId": {"$ref": "#/$defs/nonEmptyId"},
            "activeDeliveryBindingId": {"type": "string", "minLength": 22, "maxLength": 128, "pattern": "^[A-Za-z0-9._~-]+$"},
            "dataAccessEndpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ipv4Addr", "port", "securityMethods"],
              "properties": {
                "ipv4Addr": {"type": "string", "format": "ipv4"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "securityMethods": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "enum": ["OAUTH", "PKI", "PSK"]}
                }
              }
            }
          }
        }
      }
    },
    "a1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiRoot", "statusCallbackRoot"],
      "properties": {
        "apiRoot": {"$ref": "#/$defs/httpsUri"},
        "statusCallbackRoot": {"$ref": "#/$defs/httpsUri"}
      }
    },
    "e2Inventory": {
      "$ref": "e2-capability-inventory.1.0.0.schema.json",
      "description": "A schema-valid baseline inventory. Negative scenarios deep-copy and mutate it; the supplied vector itself must satisfy READY implications and structured globalE2NodeId uniqueness."
    },
    "o1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["netconf", "fileDataReporting", "sftp", "perfMetricJob", "live"],
      "properties": {
        "netconf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "knownHostsRef", "credentialRef"],
          "properties": {
            "endpoint": {"type": "string", "format": "uri", "pattern": "^ssh://"},
            "knownHostsRef": {"$ref": "#/$defs/secretRef"},
            "credentialRef": {"$ref": "#/$defs/secretRef"}
          }
        },
        "fileDataReporting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mnsRoot", "mnsVersion", "mnsAgentDn", "consumerReference", "subscriptionId"],
          "properties": {
            "mnsRoot": {"$ref": "#/$defs/httpsUri"},
            "mnsVersion": {"type": "string", "minLength": 1},
            "mnsAgentDn": {"type": "string", "minLength": 1},
            "consumerReference": {"$ref": "#/$defs/httpsUri"},
            "subscriptionId": {"$ref": "#/$defs/nonEmptyId"}
          }
        },
        "sftp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedAuthorities", "knownHostsRef", "credentialRef"],
          "properties": {
            "allowedAuthorities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "knownHostsRef": {"$ref": "#/$defs/secretRef"},
            "credentialRef": {"$ref": "#/$defs/secretRef"}
          }
        },
        "perfMetricJob": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "managedObjectDn", "managedObjectUri"],
          "properties": {
            "jobId": {"$ref": "#/$defs/nonEmptyId"},
            "managedObjectDn": {"type": "string", "minLength": 1},
            "managedObjectUri": {"type": "string", "format": "uri"}
          }
        },
        "live": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedPolicyCellCount", "expectedMeasurementWindow", "recoveryFiles"],
          "properties": {
            "expectedPolicyCellCount": {"const": 2},
            "expectedMeasurementWindow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "string", "format": "date-time"},
                "end": {"type": "string", "format": "date-time"}
              }
            },
            "recoveryFiles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uniqueCandidate", "ambiguousCandidates"],
              "properties": {
                "uniqueCandidate": {"$ref": "#/$defs/fileInfo"},
                "ambiguousCandidates": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"$ref": "#/$defs/fileInfo"}
                }
              }
            }
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nearRtRicId", "ueId", "servingCell", "targetCell", "cellMappings"],
      "properties": {
        "nearRtRicId": {"$ref": "#/$defs/nonEmptyId"},
        "ueId": {"type": "object", "minProperties": 1},
        "servingCell": {"$ref": "#/$defs/cell"},
        "targetCell": {"$ref": "#/$defs/cell"},
        "cellMappings": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validity", "trace"],
      "properties": {
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notBefore", "expiresAt"],
          "properties": {
            "notBefore": {"type": "string", "format": "date-time"},
            "expiresAt": {"type": "string", "format": "date-time"}
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intentId", "idempotencyKey", "correlationId", "producerId"],
          "properties": {
            "intentId": {"type": "string", "format": "uuid"},
            "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 255},
            "correlationId": {"type": "string", "format": "uuid"},
            "producerId": {"$ref": "#/$defs/nonEmptyId"}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truststoreRef", "r1ClientCredentialRef", "o1NotificationCredentialRef"],
      "properties": {
        "truststoreRef": {"$ref": "#/$defs/secretRef"},
        "r1ClientCredentialRef": {"$ref": "#/$defs/secretRef"},
        "o1NotificationCredentialRef": {"$ref": "#/$defs/secretRef"}
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultStepMs", "liveCaptureMs", "notificationWindowMs"],
      "properties": {
        "defaultStepMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "liveCaptureMs": {"type": "integer", "minimum": 1, "maximum": 900000},
        "notificationWindowMs": {"const": 120000}
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyEvidenceRecordSchema", "policyEvidenceRecordSchemaCanonicalJson", "policyEvidenceRecordSchemaJcsSha256", "policyEvidenceFilterSchemaJcsSha256"],
      "properties": {
        "policyEvidenceRecordSchema": {"type": "object"},
        "policyEvidenceRecordSchemaCanonicalJson": {
          "type": "string",
          "minLength": 2,
          "description": "Exact RFC 8785 canonical JSON text of policyEvidenceRecordSchema for the R1 DmeTypeDefinition.dataDeliverySchemas[].schema wire string. Preflight parses it, compares the value to policyEvidenceRecordSchema and verifies the declared digest."
        },
        "policyEvidenceRecordSchemaJcsSha256": {"$ref": "#/$defs/sha256"},
        "policyEvidenceFilterSchemaJcsSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "httpsUri": {"type": "string", "format": "uri", "pattern": "^https://"},
    "secretRef": {"type": "string", "minLength": 1, "pattern": "^(secret|vault|k8s-secret)://"},
    "nonEmptyId": {"type": "string", "minLength": 1, "maxLength": 255},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cellId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plmnId", "cId"],
      "properties": {
        "plmnId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcc", "mnc"],
          "properties": {
            "mcc": {"type": "string", "pattern": "^[0-9]{3}$"},
            "mnc": {"type": "string", "pattern": "^[0-9]{2,3}$"}
          }
        },
        "cId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ncI"],
          "properties": {"ncI": {"type": "integer", "minimum": 0, "maximum": 68719476735}}
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "managedObjectDn"],
      "properties": {
        "cellId": {"$ref": "#/$defs/cellId"},
        "managedObjectDn": {"type": "string", "minLength": 1}
      }
    },
    "fileInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileLocation", "fileSize", "fileReadyTime", "fileExpirationTime", "fileCompression", "fileFormat", "fileDataType", "jobId"],
      "properties": {
        "fileLocation": {"type": "string", "format": "uri", "pattern": "^sftp://"},
        "fileSize": {"type": "integer", "minimum": 1},
        "fileReadyTime": {"type": "string", "format": "date-time"},
        "fileExpirationTime": {"type": "string", "format": "date-time"},
        "fileCompression": {"type": "string"},
        "fileFormat": {"const": "32.435 V10.0 XML-schema"},
        "fileDataType": {"const": "PERFORMANCE"},
        "jobId": {"$ref": "#/$defs/nonEmptyId"}
      }
    }
  },
  "allOf": [
    {
      "description": "The runner additionally enforces start < end, serving/target inequality, directed-neighbour membership, bijective CellId/DN mappings, every FileInfo fileReadyTime < fileExpirationTime, and schema digest equality before any network side effect."
    }
  ]
}
