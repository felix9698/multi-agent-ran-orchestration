{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oran-aic:AIC_SliceSLATarget_1.0.0:policy",
  "title": "AIC Slice SLA Target policy",
  "description": "Project policy binding to E2SM-RC v1.03 Style 2 Action 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "quota", "validity", "trace"],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plmnId", "snssai"],
      "properties": {
        "plmnId": {"$ref": "#/$defs/plmnId"},
        "snssai": {"$ref": "#/$defs/snssai"}
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minPrbPolicyRatio", "maxPrbPolicyRatio", "dedicatedPrbPolicyRatio"],
      "properties": {
        "minPrbPolicyRatio": {"type": "integer", "minimum": 0, "maximum": 100},
        "maxPrbPolicyRatio": {"type": "integer", "minimum": 0, "maximum": 100},
        "dedicatedPrbPolicyRatio": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notBefore", "notAfter"],
      "properties": {
        "notBefore": {"type": "string", "format": "date-time"},
        "notAfter": {"type": "string", "format": "date-time"}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "revision", "fencingToken"],
      "properties": {
        "traceId": {"type": "string", "minLength": 1, "maxLength": 255},
        "revision": {"type": "integer", "minimum": 1},
        "fencingToken": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "plmnId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcc", "mnc"],
      "properties": {
        "mcc": {"type": "string", "pattern": "^[0-9]{3}$"},
        "mnc": {"type": "string", "pattern": "^[0-9]{2,3}$"}
      }
    },
    "snssai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sst"],
      "properties": {
        "sst": {"type": "integer", "minimum": 1, "maximum": 255},
        "sd": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"}
      }
    }
  }
}
