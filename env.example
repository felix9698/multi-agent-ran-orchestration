# Optional model configuration. Copy to .env; never commit real credentials.
# Current entry points read the process environment. Load your trusted file with
# `set -a; . ./.env; set +a` in the launch shell; .env is not loaded automatically.
# Enable only the backend(s) you use, with a model ID available to your account.

# Anthropic API
# ANTHROPIC_API_KEY=YOUR_API_KEY
# AIC_CLAUDE_MODEL_ID=YOUR_PROVIDER_MODEL_ID

# OpenAI API
# OPENAI_API_KEY=YOUR_API_KEY

# Google Gemini API (the existing adapter uses google-generativeai)
# GOOGLE_API_KEY=YOUR_API_KEY

# OpenAI-compatible inference service, including a local model server.
# This is your own endpoint; no author-hosted service is required.
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=YOUR_SERVER_KEY
# LITELLM_MAX_TOKENS=4096
# LITELLM_TIMEOUT=120

# Optional Anthropic-compatible endpoint; omit for direct Anthropic access.
# ANTHROPIC_BASE_URL=https://your-endpoint.example
# ANTHROPIC_AUTH_TOKEN=YOUR_ENDPOINT_TOKEN

# Lab-only subscriber inputs for the legacy preparation adapter.
# Use values you provisioned in your own core; never use example SIM credentials.
# AIC_UICC_KEY=YOUR_32_HEX_DIGIT_KEY
# AIC_UICC_OPC=YOUR_32_HEX_DIGIT_OPC
# AIC_MYSQL_PASSWORD=YOUR_DATABASE_PASSWORD
