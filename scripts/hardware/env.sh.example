# scripts/hardware/env.sh.example — copy to env.sh and edit for your lab.
#
# Machine-specific paths only. NEVER put a SIM key (Ki/OPc), IMSI, subscriber
# value or SSH password here. env.sh is git-ignored.

# --- near-RT RIC (non-root) ---
export HW_RIC_BIN="${HW_RIC_BIN:-$HOME/flexric-rc-nested-encoder-fix/build-gcc12/examples/ric/nearRT-RIC}"
export HW_RIC_CONF="${HW_RIC_CONF:-$HOME/a1p-stage/phase-b-rc-capability-patch-3/runtime/flexric/flexric.conf}"
export HW_RUNTIME_DIR="${HW_RUNTIME_DIR:-$HOME/rlive}"        # witness.json, sm/, headers
export HW_WITNESS="${HW_WITNESS:-$HW_RUNTIME_DIR/witness.json}"

# --- gNB (operator sudo on PC1 / enb2) ---
export HW_GNB1_RESTART="${HW_GNB1_RESTART:-$HOME/oran-deploy/session-20260819/restart-gnb1-campaign5-38prb.sh}"
export HW_GNB2_RESTART="${HW_GNB2_RESTART:-/opt/ran-lab/gnb2/restart-gnb2-38prb.sh}"
export HW_GNB2_HOST="${HW_GNB2_HOST:-enb2}"
export HW_GNB_SOFTMODEM_PROCESS="${HW_GNB_SOFTMODEM_PROCESS:-nr-softmodem}"

# --- xApp (our_rc_xapp: E2SM-RC Style-2 controls over the O-RAN path) ---
export HW_XAPP_BIN="${HW_XAPP_BIN:-$HW_RUNTIME_DIR/customxapp/our_rc_xapp}"
export HW_XAPP_CONF="${HW_XAPP_CONF:-$HW_RIC_CONF}"
export HW_GNB1_NB_ID="${HW_GNB1_NB_ID:-3584}"                 # 0xE00
export LOWER_LIVE="${LOWER_LIVE:-$HOME/oran-deploy/session-20260819/lower-live}"

# --- Campaign-5 Action producer (second A1-P endpoint, live xApp worker) ---
# Recommended lab reuse: the existing nonrt-r1-server certificate/key (whose
# SAN includes 192.168.50.1), the session client CA, and the rotating R1 access
# token. These are references only; never copy secret or key material here.
export HW_CAMPAIGN5_LISTEN_HOST="${HW_CAMPAIGN5_LISTEN_HOST:-192.168.50.1}"
export HW_CAMPAIGN5_PORT="${HW_CAMPAIGN5_PORT:-9445}"
export HW_CAMPAIGN5_TLS_CERT_REF="${HW_CAMPAIGN5_TLS_CERT_REF:-file://$HOME/oran-deploy/session-20260819/secrets/r1/nonrt-r1-server.crt}"
export HW_CAMPAIGN5_TLS_KEY_REF="${HW_CAMPAIGN5_TLS_KEY_REF:-file://$HOME/oran-deploy/session-20260819/secrets/r1/nonrt-r1-server.key}"
export HW_CAMPAIGN5_CLIENT_CA_REF="${HW_CAMPAIGN5_CLIENT_CA_REF:-file://$HOME/oran-deploy/session-20260819/secrets/clients/ca.crt}"
export HW_CAMPAIGN5_BEARER_TOKEN_REF="${HW_CAMPAIGN5_BEARER_TOKEN_REF:-file://$HOME/oran-deploy/session-20260819/secrets/r1/r1-access-token}"
export HW_CAMPAIGN5_CELL_ID="${HW_CAMPAIGN5_CELL_ID:-12345678}"

# Optional live-worker paths and safety windows. HW_KPM_MAX_AGE_SECONDS is
# shared with readiness.sh; 5 seconds is the action worker's fail-closed live
# default and still requires the gate to be actively appending.
export HW_CAMPAIGN5_KPM_JSONL="${HW_CAMPAIGN5_KPM_JSONL:-$LOWER_LIVE/a1-live-kpm.jsonl}"
export HW_CAMPAIGN5_LEDGER="${HW_CAMPAIGN5_LEDGER:-$HW_RUNTIME_DIR/campaign5-live-worker.json}"
export HW_CAMPAIGN5_GATE_PROBE_SECONDS="${HW_CAMPAIGN5_GATE_PROBE_SECONDS:-2}"
export HW_KPM_MAX_AGE_SECONDS="${HW_KPM_MAX_AGE_SECONDS:-5}"
export HW_CAMPAIGN5_CONTROL_DEADLINE_SECONDS="${HW_CAMPAIGN5_CONTROL_DEADLINE_SECONDS:-18}"
export HW_CAMPAIGN5_EXPIRY_POLL_SECONDS="${HW_CAMPAIGN5_EXPIRY_POLL_SECONDS:-1}"

# --- Campaign-5 supplementary-action producer ---
# Required only when running run_campaign5_producer.sh. Keep all TLS and token
# values as file:// references; never paste credentials, a private key, or a
# bearer token into this file. Uncomment and replace these for this lab.
# export HW_CAMPAIGN5_LISTEN_HOST="0.0.0.0"
# export HW_CAMPAIGN5_PORT="9445"
# export HW_CAMPAIGN5_TLS_CERT_REF="file:///path/to/rapp-r1-client.crt"
# export HW_CAMPAIGN5_TLS_KEY_REF="file:///path/to/rapp-r1-client.key"
# export HW_CAMPAIGN5_CLIENT_CA_REF="file:///path/to/ca.crt"
# export HW_CAMPAIGN5_BEARER_TOKEN_REF="file:///path/to/r1-access-token"
# export HW_CAMPAIGN5_CELL_ID="12345678"
# Optional: defaults are HW_LIVE_ARTIFACT_ROOT/a1-live-kpm.jsonl and the runtime ledger.
# export HW_CAMPAIGN5_KPM_JSONL="$HW_LIVE_ARTIFACT_ROOT/a1-live-kpm.jsonl"

# --- KPM header refresh ---
export HW_KPM_XAPP="${HW_KPM_XAPP:-$HOME/a1p-stage/build-qos-kpm-multislice/kpm_gate_xapp}"
export HW_TOPOLOGY="${HW_TOPOLOGY:-208-95-2-0xe00-32-20895-12345678,208-95-2-0xb00-32-20895-87654321}"
export HW_SNSSAIS="${HW_SNSSAIS:-1,222:00007b}"

# --- data network / UEs ---
export HW_EXT_DN="${HW_EXT_DN:-oai-ext-dn}"                   # docker container name
export HW_EXT_DN_CONTAINER="${HW_EXT_DN_CONTAINER:-$HW_EXT_DN}"
export HW_UE_PRIME_TARGET="${HW_UE_PRIME_TARGET:-192.168.70.135}"
export HW_UE_PRB24_LAUNCHER="${HW_UE_PRB24_LAUNCHER:-ai-ran-nrue-start-gnb1-prb24}"
export HW_UE_GENERIC_LAUNCHER="${HW_UE_GENERIC_LAUNCHER:-ai-ran-nrue-start-prb}"

# --- Cockpit LIVE readiness / A1-P re-pin ---
# These are paths and host aliases, never credentials.  The re-pin script gets
# container image, command, mount and KPM environment from docker inspect.
# One-release compatibility: a pre-migration env.sh may still set LOWER_LIVE.
# New configurations must set HW_LIVE_ARTIFACT_ROOT instead.
export HW_LIVE_ARTIFACT_ROOT="${HW_LIVE_ARTIFACT_ROOT:-${LOWER_LIVE:-$HOME/oran-deploy/session-20260819/lower-live}}"
export HW_ASSURANCE_BINDING="${HW_ASSURANCE_BINDING:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/deployment/assurance-live-binding.1.0.0.json}"
export HW_FLEXRIC_WITNESS="${HW_FLEXRIC_WITNESS:-/run/ai-ran/flexric-connection-witness.json}"
export HW_KPM_UE_ATTRIBUTION_LINES="${HW_KPM_UE_ATTRIBUTION_LINES:-64}"
export HW_UE1_HOST="${HW_UE1_HOST:-ue1}"                  # ip -4 -o addr show up dev oaitun_ue1
export HW_UE2_HOST="${HW_UE2_HOST:-ue2}"                  # ip -4 -o addr show up dev oaitun_ue1
export HW_UE3_HOST="${HW_UE3_HOST:-ue3}"
# A session using only UE1 leaves UE2 observable but non-blocking.  Set ue1,ue2
# before a dual-UE run so both attachments are required.
export HW_REQUIRED_UES="${HW_REQUIRED_UES:-ue1}"
export HW_GNB1_HOST="${HW_GNB1_HOST:-localhost}"
export HW_GNB2_LOG="${HW_GNB2_LOG:-/opt/ran-lab/gnb2/oai-build-actionspace/logs/gnb2-*.log}"
export HW_GNB1_LOG="${HW_GNB1_LOG:-$HOME/oran-deploy/session-20260819/logs/gnb1-actionspace24-*.log}"
export HW_GNB1_RUNNING_CONF="${HW_GNB1_RUNNING_CONF:-}"
export HW_GNB1_PROCESS="${HW_GNB1_PROCESS:-nr-softmodem}"
export HW_GNB2_PROCESS="${HW_GNB2_PROCESS:-nr-softmodem}"
