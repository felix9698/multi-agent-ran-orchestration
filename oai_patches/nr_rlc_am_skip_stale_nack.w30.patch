+
+/* A NACK for an SN the peer already let us release (behind tx_next_ack): we cannot
+ * retransmit it any more.  Rejecting the whole STATUS PDU for it froze the UL window
+ * after a handover until RLF (2026-09-24, ue1/ue3: `bad NACK, bigger than ACK (nack 67
+ * ack 68) (tx_next_ack 68 ...)` repeated thousands of times).  Skip only that NACK.
+ */
+static int nack_is_stale(nr_rlc_entity_am_t *entity, int nack_sn)
+{
+  int behind = (entity->tx_next_ack - nack_sn + entity->sn_modulus) % entity->sn_modulus;
+  return behind >= 1 && behind <= entity->window_size;
+}
