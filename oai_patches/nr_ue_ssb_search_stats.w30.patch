+/* 2026-09-24 (O-RAN testbed): count where the SSB search fails -- the PSS gate, the FFT span,
+ * SSS or the serving-cell exclusion -- and print a line every 200 searches, to find why a UE
+ * needs thousands of attempts on some links.  Stage 1 = PSS (see pss_nr.c). */
+bool nr_search_ssb_common(nr_ssb_search_params_t *params)
+{
+  static int calls = 0, ok = 0, fails[8] = {0};
+  ssb_fail_stage = 0;
+  const bool found = nr_search_ssb_common_inner(params);
+  calls++;
+  if (found)
+    ok++;
+  else if (ssb_fail_stage > 0 && ssb_fail_stage < 8)
+    fails[ssb_fail_stage]++;
+  if (calls % 200 == 0)
+    LOG_I(PHY, "[UE] SSB search stats: calls %d ok %d fail pss %d ofdmdiv %d span %d sss %d excl %d other %d/%d\n",
+          calls, ok, fails[1], fails[2], fails[3], fails[4], fails[5], fails[6], fails[7]);
+  return found;
+}
