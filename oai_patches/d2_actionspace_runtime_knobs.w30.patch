+/* Runtime TX attenuation control for the RF frontend (USRP).
+ * "rfatt"          -> print current TX attenuation (dB from max gain)
+ * "rfatt <att_dB>" -> apply new TX attenuation immediately (no restart)
+ * Used by the intent coordinator as the per-cell power-offset knob. */
+static int rfatt_cmd(char *buf, int debug, telnet_printfunc_t prnt)
+{
+  if (RC.nb_RU < 1 || !RC.ru[0])
+    ERROR_MSG_RET("no RU present\n");
+  RU_t *ru = RC.ru[0];
+  double att;
+  if (!buf || sscanf(buf, "%lf", &att) != 1) {
+    prnt("current TX attenuation %.1f dB\n", ru->openair0_cfg.tx_gain[0]);
+    return 0;
+  }
+  if (att < 0.0 || att > 60.0)
+    ERROR_MSG_RET("attenuation %.1f out of range [0,60] dB\n", att);
+  if (!ru->rfdevice.trx_set_gains_func)
+    ERROR_MSG_RET("RF device does not support runtime gain setting\n");
+  for (int i = 0; i < ru->nb_tx && i < 8; ++i)
+    ru->openair0_cfg.tx_gain[i] = att;
+  ru->rfdevice.trx_set_gains_func(&ru->rfdevice, &ru->openair0_cfg);
+  prnt("TX attenuation set to %.1f dB\n", att);
+  return 0;
+}
+
+/* --- d>=2 action-space runtime knobs (agentic_intent_coordinator) -----------
+ * MAC-level scheduling parameters exposed for in-loop (no-restart) control,
+ * mirroring the rfatt TX-power knob above. The DL scheduler re-reads these
+ * fields on RC.nrmac[0] every slot, so a write takes effect on the next slot.
+ * All writes take the scheduler lock, like the rest of the MAC control path. */
+
+/* "mcs"             -> print current DL/UL MCS caps
+ * "mcs <max>"       -> set DL MCS ceiling (RC.nrmac[0]->dl_bler.max_mcs)
+ * "mcs <max> <min>" -> also set the DL MCS floor
+ * Persistent DL MCS cap: unlike the per-UE sched_ctrl->dl_max_mcs it is NOT
+ * overwritten by CSI/CQI reports. */
+static int mcs_cmd(char *buf, int debug, telnet_printfunc_t prnt)
+{
+  if (!RC.nrmac || !RC.nrmac[0])
+    ERROR_MSG_RET("no MAC present\n");
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  int max_mcs = -1, min_mcs = -1;
+  if (!buf || sscanf(buf, "%d %d", &max_mcs, &min_mcs) < 1) {
+    prnt("DL MCS cap [%d..%d] UL MCS cap [%d..%d]\n",
+         mac->dl_bler.min_mcs, mac->dl_bler.max_mcs,
+         mac->ul_bler.min_mcs, mac->ul_bler.max_mcs);
+    return 0;
+  }
+  if (max_mcs < 0 || max_mcs > 28)
+    ERROR_MSG_RET("max_mcs %d out of range [0,28]\n", max_mcs);
+  NR_SCHED_LOCK(&mac->sched_lock);
+  mac->dl_bler.max_mcs = (uint8_t)max_mcs;
+  if (min_mcs >= 0 && min_mcs <= max_mcs)
+    mac->dl_bler.min_mcs = (uint8_t)min_mcs;
+  if (mac->dl_bler.min_mcs > mac->dl_bler.max_mcs)
+    mac->dl_bler.min_mcs = mac->dl_bler.max_mcs;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  prnt("DL MCS cap set to [%d..%d]\n", mac->dl_bler.min_mcs, mac->dl_bler.max_mcs);
+  return 0;
+}
+
+/* "prbcap"            -> print the cell DL PRB cap and any per-UE caps
+ * "prbcap <n>"        -> set the CELL DL PRB cap (caps every UE on the cell)
+ * "prbcap <n> <rnti>" -> set one UE's per-UE DL PRB cap (hex RNTI)
+ * 0 removes the cap. Cell cap -> RC.nrmac[0]->dl_max_rbSize; per-UE cap ->
+ * sched_ctrl->dl_max_rbSize; the DL scheduler grants the tighter of the two. */
+static int prbcap_cmd(char *buf, int debug, telnet_printfunc_t prnt)
+{
+  if (!RC.nrmac || !RC.nrmac[0])
+    ERROR_MSG_RET("no MAC present\n");
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  char *sn = buf ? strtok(buf, " ") : NULL;
+  char *srnti = sn ? strtok(NULL, " ") : NULL;
+  if (!sn) {
+    if (mac->dl_max_rbSize == 0)
+      prnt("DL PRB cap 0 (uncapped)\n");
+    else
+      prnt("DL PRB cap %d\n", mac->dl_max_rbSize);
+    UE_iterator(mac->UE_info.connected_ue_list, it) {
+      if (it->UE_sched_ctrl.dl_max_rbSize > 0)
+        prnt("UE %04x DL PRB cap %d\n", it->rnti, it->UE_sched_ctrl.dl_max_rbSize);
+    }
+    return 0;
+  }
+  int n = (int)strtol(sn, NULL, 10);
+  if (n < 0 || n > 275)
+    ERROR_MSG_RET("prb cap %d out of range [0,275]\n", n);
+  if (!srnti) {
+    /* cell-wide cap: applies to every UE on the cell */
+    NR_SCHED_LOCK(&mac->sched_lock);
+    mac->dl_max_rbSize = (uint16_t)n;
+    NR_SCHED_UNLOCK(&mac->sched_lock);
+    if (n == 0)
+      prnt("DL PRB cap set to 0 (uncapped)\n");
+    else
+      prnt("DL PRB cap set to %d\n", n);
+    return 0;
+  }
+  /* per-UE cap: partition resources among UEs sharing a cell */
+  int rnti = fetch_rnti(srnti, prnt);
+  if (rnti < 0)
+    ERROR_MSG_RET("could not identify UE (no UE, no such RNTI, or multiple UEs)\n");
+  NR_UE_info_t *UE = find_nr_UE(&mac->UE_info, rnti);
+  if (!UE)
+    ERROR_MSG_RET("could not find UE with RNTI %04x\n", rnti);
+  NR_SCHED_LOCK(&mac->sched_lock);
+  UE->UE_sched_ctrl.dl_max_rbSize = (uint16_t)n;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (n == 0)
+    prnt("UE %04x DL PRB cap set to 0 (uncapped)\n", rnti);
+  else
+    prnt("UE %04x DL PRB cap set to %d\n", rnti, n);
+  return 0;
+}
+
+/* "sched_prio"            -> list connected UEs and their PF weights
+ * "sched_prio <w>"        -> set PF weight of the single connected UE
+ * "sched_prio <w> <rnti>" -> set PF weight of a specific UE (hex RNTI)
+ * Writes UE->UE_sched_ctrl.pf_weight; the DL PF coefficient is multiplied by
+ * it (1.0 = neutral, >1 favors, <1 starves). */
+static int sched_prio_cmd(char *buf, int debug, telnet_printfunc_t prnt)
+{
+  if (!RC.nrmac || !RC.nrmac[0])
+    ERROR_MSG_RET("no MAC present\n");
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  char *sweight = buf ? strtok(buf, " ") : NULL;
+  char *srnti = sweight ? strtok(NULL, " ") : NULL;
+  if (!sweight) {
+    UE_iterator(mac->UE_info.connected_ue_list, it) {
+      prnt("UE %04x PF weight %.3f\n", it->rnti, it->UE_sched_ctrl.pf_weight);
+    }
+    return 0;
+  }
+  double w = strtod(sweight, NULL);
+  if (w <= 0.0 || w > 100.0)
+    ERROR_MSG_RET("weight %.3f out of range (0,100]\n", w);
+  int rnti = fetch_rnti(srnti, prnt);
+  if (rnti < 0)
+    ERROR_MSG_RET("could not identify UE (no UE, no such RNTI, or multiple UEs)\n");
+  NR_UE_info_t *UE = find_nr_UE(&mac->UE_info, rnti);
+  if (!UE)
+    ERROR_MSG_RET("could not find UE with RNTI %04x\n", rnti);
+  NR_SCHED_LOCK(&mac->sched_lock);
+  UE->UE_sched_ctrl.pf_weight = (float)w;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  prnt("UE %04x PF weight set to %.3f\n", rnti, w);
+  return 0;
+}
+
 static telnetshell_cmddef_t cicmds[] = {
+    {"rfatt", "[tx_att_dB(float,opt)]", rfatt_cmd},
+    {"mcs", "[max_mcs(int,opt) [min_mcs(int,opt)]]", mcs_cmd},
+    {"prbcap", "[n_prb(int,opt) [rnti(hex,opt)]]", prbcap_cmd},
+    {"sched_prio", "[weight(float,opt) [rnti(hex,opt)]]", sched_prio_cmd},
     {"get_single_rnti", "", get_single_rnti},
     {"force_reestab", "[rnti(hex,opt)]", trigger_reestab},
     {"get_reestab_count", "[rnti(hex,opt)]", get_reestab_count},
