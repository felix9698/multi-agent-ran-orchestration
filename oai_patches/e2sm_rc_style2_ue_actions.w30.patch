+static sm_ag_if_ans_t rc_ctrl_style_2_dl_mcs_bounds(const e2sm_rc_ctrl_msg_frmt_1_t* m)
+{
+  const char* why = "";
+  const ran_param_struct_t* bounds = rc_style2_structure_root(m, RC_DL_MCS_BOUNDS, &why);
+  static const uint32_t child_ids[] = {RC_DL_MCS_MAX, RC_DL_MCS_MIN};
+  if (bounds == NULL
+      || !rc_exact_parameter_ids(bounds->ran_param_struct, bounds->sz_ran_param_struct, child_ids, 2, &why))
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, RC_ACTION_101_DL_MCS_BOUNDS, why);
+
+  const ran_parameter_value_t* maximum = rc_false_element(
+      rc_find_ran_param(bounds->ran_param_struct, bounds->sz_ran_param_struct, RC_DL_MCS_MAX),
+      INTEGER_RAN_PARAMETER_VALUE,
+      &why);
+  const ran_parameter_value_t* minimum = rc_false_element(
+      rc_find_ran_param(bounds->ran_param_struct, bounds->sz_ran_param_struct, RC_DL_MCS_MIN),
+      INTEGER_RAN_PARAMETER_VALUE,
+      &why);
+  if (maximum == NULL || minimum == NULL)
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, RC_ACTION_101_DL_MCS_BOUNDS, why);
+  if (minimum->int_ran < 0 || maximum->int_ran > 28 || minimum->int_ran > maximum->int_ran)
+    return rc_ctrl_reject(RC_CTRL_REJ_POLICY_OR_ADMISSION,
+                          2,
+                          RC_ACTION_101_DL_MCS_BOUNDS,
+                          "DL MCS bounds must satisfy 0 <= min <= max <= 28");
+  if (RC.nrmac[0] == NULL)
+    return rc_ctrl_reject(RC_CTRL_REJ_CAPABILITY_STATE,
+                          2,
+                          RC_ACTION_101_DL_MCS_BOUNDS,
+                          "MAC instance is not ready");
+
+  gNB_MAC_INST* mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  mac->dl_bler.min_mcs = (uint8_t)minimum->int_ran;
+  mac->dl_bler.max_mcs = (uint8_t)maximum->int_ran;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  printf("[E2 AGENT] RIC CONTROL Style 2 / Action %u applied: DL MCS [%" PRId64 "..%" PRId64 "]\n",
+         RC_ACTION_101_DL_MCS_BOUNDS,
+         minimum->int_ran,
+         maximum->int_ran);
+  fflush(stdout);
+  return rc_ctrl_empty_outcome();
+}
