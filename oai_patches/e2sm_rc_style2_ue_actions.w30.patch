+static const ran_param_struct_t* rc_style2_structure_root(const e2sm_rc_ctrl_msg_frmt_1_t* m,
+                                                          uint32_t root_id,
+                                                          const char** why)
+{
+  const uint32_t root_ids[] = {root_id};
+  if (!rc_exact_parameter_ids(m->ran_param, m->sz_ran_param, root_ids, 1, why))
+    return NULL;
+  const seq_ran_param_t* root = rc_find_ran_param(m->ran_param, m->sz_ran_param, root_id);
+  if (root == NULL || root->ran_param_val.type != STRUCTURE_RAN_PARAMETER_VAL_TYPE
+      || root->ran_param_val.strct == NULL) {
+    *why = "deployment-local root RAN Parameter is not a STRUCTURE";
