+
+static void rrc_gNB_process_e2_style2_ue_control_req(gNB_RRC_INST *rrc,
+                                                     const nr_rrc_e2_style2_ue_control_req_t *req)
+{
+  rrc_gNB_ue_context_t *ue_context = rrc_gNB_get_ue_context(rrc, req->rrc_ue_id);
+  if (ue_context == NULL) {
+    LOG_E(NR_RRC, "E2 Style 2 UE control: no UE context for rrc_ue_id %u, deferred apply dropped\n", req->rrc_ue_id);
+    return;
+  }
+  if (RC.nrmac[0] == NULL) {
+    LOG_E(NR_RRC, "E2 Style 2 UE control: MAC instance is not ready, deferred apply dropped\n");
+    return;
+  }
+
+  const rnti_t rnti = ue_context->ue_context.rnti;
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  NR_UE_info_t *mac_ue = find_nr_UE(&mac->UE_info, rnti);
+  if (mac_ue == NULL) {
+    NR_SCHED_UNLOCK(&mac->sched_lock);
+    LOG_E(NR_RRC,
+          "E2 Style 2 UE control: no MAC UE for rrc_ue_id %u/RNTI %04x, deferred apply dropped\n",
+          req->rrc_ue_id,
+          rnti);
+    return;
+  }
+
+  switch (req->action_id) {
+    case NR_RRC_E2_STYLE2_ACTION_UE_DL_PRB_CAP:
+      mac_ue->UE_sched_ctrl.dl_max_rbSize = req->max_dl_prbs;
+      break;
+    case NR_RRC_E2_STYLE2_ACTION_UE_PF_WEIGHT:
+      mac_ue->UE_sched_ctrl.pf_weight = (float)req->pf_weight;
+      break;
+    default:
+      NR_SCHED_UNLOCK(&mac->sched_lock);
+      LOG_E(NR_RRC, "E2 Style 2 UE control: unsupported deferred action %u dropped\n", req->action_id);
+      return;
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+
+  if (req->action_id == NR_RRC_E2_STYLE2_ACTION_UE_DL_PRB_CAP)
+    LOG_I(NR_RRC,
+          "E2 Style 2 / Action %u applied: rrc_ue_id=%u RNTI=%04x maxDlPrbs=%u\n",
+          req->action_id,
+          req->rrc_ue_id,
+          rnti,
+          req->max_dl_prbs);
+  else
+    LOG_I(NR_RRC,
+          "E2 Style 2 / Action %u applied: rrc_ue_id=%u RNTI=%04x pfWeight=%.3f\n",
+          req->action_id,
+          req->rrc_ue_id,
+          rnti,
+          req->pf_weight);
+}
