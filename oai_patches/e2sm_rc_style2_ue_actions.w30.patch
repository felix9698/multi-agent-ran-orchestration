+static sm_ag_if_ans_t rc_ctrl_style_2_ue_action(const e2sm_rc_ctrl_hdr_frmt_1_t* h,
+                                                const e2sm_rc_ctrl_msg_frmt_1_t* m)
+{
+  const bool is_prb_cap = h->ctrl_act_id == RC_ACTION_102_UE_DL_PRB_CAP;
+  const uint32_t root_id = is_prb_cap ? RC_UE_DL_PRB_CAP : RC_UE_PF_WEIGHT;
+  const uint32_t child_id = is_prb_cap ? RC_MAX_DL_PRBS : RC_PF_WEIGHT;
+  const char* why = "";
+  const ran_param_struct_t* value_struct = rc_style2_structure_root(m, root_id, &why);
+  const uint32_t child_ids[] = {child_id};
+  if (value_struct == NULL
+      || !rc_exact_parameter_ids(
+          value_struct->ran_param_struct, value_struct->sz_ran_param_struct, child_ids, 1, &why))
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, h->ctrl_act_id, why);
+
+  const seq_ran_param_t* value_param = rc_find_ran_param(
+      value_struct->ran_param_struct, value_struct->sz_ran_param_struct, child_id);
+  if (value_param == NULL
+      || value_param->ran_param_val.type != ELEMENT_KEY_FLAG_FALSE_RAN_PARAMETER_VAL_TYPE
+      || value_param->ran_param_val.flag_false == NULL)
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT,
+                          2,
+                          h->ctrl_act_id,
+                          "action value has wrong key flag or is absent");
+
+  nr_rrc_e2_style2_ue_control_req_t req = {
+      .action_id = h->ctrl_act_id,
+  };
+  const ran_parameter_value_t* value = value_param->ran_param_val.flag_false;
+  if (is_prb_cap) {
+    if (value->type != INTEGER_RAN_PARAMETER_VALUE)
+      return rc_ctrl_reject(
+          RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, h->ctrl_act_id, "Maximum DL PRBs is not an INTEGER");
+    if (value->int_ran < 0 || value->int_ran > 275)
+      return rc_ctrl_reject(
+          RC_CTRL_REJ_POLICY_OR_ADMISSION, 2, h->ctrl_act_id, "Maximum DL PRBs is outside 0..275");
+    req.max_dl_prbs = (uint16_t)value->int_ran;
+  } else {
+    if (value->type == REAL_RAN_PARAMETER_VALUE)
+      req.pf_weight = value->real_ran;
+    else if (value->type == INTEGER_RAN_PARAMETER_VALUE)
+      req.pf_weight = value->int_ran;
+    else
+      return rc_ctrl_reject(
+          RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, h->ctrl_act_id, "PF Weight is not a REAL or INTEGER");
+    if (!isfinite(req.pf_weight) || req.pf_weight < 0.001 || req.pf_weight > 100.0)
+      return rc_ctrl_reject(
+          RC_CTRL_REJ_POLICY_OR_ADMISSION, 2, h->ctrl_act_id, "PF Weight is outside 0.001..100");
+  }
+
+  if (!rc_extract_rrc_ue_id(&h->ue_id, &req.rrc_ue_id))
+    return rc_ctrl_reject(RC_CTRL_REJ_IDENTITY_OR_TARGET,
+                          2,
+                          h->ctrl_act_id,
+                          "E2SM-RC UE ID carries neither a gNB-CU UE F1AP ID nor gNB-RAN-UE-ID");
+  if (RC.nrmac[0] == NULL)
+    return rc_ctrl_reject(RC_CTRL_REJ_CAPABILITY_STATE, 2, h->ctrl_act_id, "MAC instance is not ready");
+  if (!rc_enqueue_style2_ue_control_req(&req))
+    return rc_ctrl_reject(RC_CTRL_REJ_POLICY_OR_ADMISSION, 2, h->ctrl_act_id, "RRC queue admission failed");
+
+  printf("[E2 AGENT] RIC CONTROL Style 2 / Action %u admitted to TASK_RRC_GNB: rrc_ue_id=%u "
+         "(CONTROL ACK confirms queue admission; MAC apply is deferred)\n",
+         h->ctrl_act_id,
+         req.rrc_ue_id);
+  fflush(stdout);
+  return rc_ctrl_empty_outcome();
+}
