+static bool rc_enqueue_style2_ue_control_req(const nr_rrc_e2_style2_ue_control_req_t* req)
+{
+  MessageDef* msg = itti_alloc_new_message(TASK_RRC_GNB, 0, NR_RRC_E2_STYLE2_UE_CONTROL_REQ);
+  if (msg == NULL)
+    return false;
+  NR_RRC_E2_STYLE2_UE_CONTROL_REQ(msg) = *req;
+
+  /* NOTE: at this pin itti_send_msg_to_task_locked() always returns 0 and the
+   * queue is an unbounded std::list, so the failure branch below is
+   * unreachable.  Do not free msg after a successful send: ownership has
+   * transferred to TASK_RRC_GNB per R3.  If the ITTI API later gains a real
+   * failure result, its ownership rule must be revisited with this branch. */
+  if (itti_send_msg_to_task(TASK_RRC_GNB, 0, msg) != 0)
+    return false;
+  return true; /* ownership transferred (R3): msg must not be touched again */
+}
