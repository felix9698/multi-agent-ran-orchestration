diff --git a/openair2/LAYER2/NR_MAC_gNB/config.c b/openair2/LAYER2/NR_MAC_gNB/config.c
index 06b6972379..1820acf17d 100644
--- a/openair2/LAYER2/NR_MAC_gNB/config.c
+++ b/openair2/LAYER2/NR_MAC_gNB/config.c
@@ -286,6 +286,22 @@ nfapi_nr_pm_list_t init_DL_MIMO_codebook(gNB_MAC_INST *gNB, nr_pdsch_AntennaPort
  * @param mixed indicates whether to include in the count also mixed slot with UL symbols or only full UL slot
  * @return slot index
  */
+/* AIC 2026-09-29: keep dedicated UL (PUSCH, SR, CSI, HARQ-ACK) out of TDD mixed
+ * slots -- some UEs are DTX there (ue3: 149/150 PUSCH DTX in slots 7/17, SR never
+ * heard).  Only when a full UL slot exists.  AIC_UL_IN_MIXED=1 restores stock. */
+bool nr_skip_mixed_ul(const frame_structure_t *fs)
+{
+  static int skip = -1;
+  if (skip < 0) {
+    const char *e = getenv("AIC_UL_IN_MIXED");
+    bool full_ul = false;
+    for (int i = 0; fs->frame_type == TDD && !full_ul && i < fs->numb_slots_period; i++)
+      full_ul = fs->period_cfg.tdd_slot_bitmap[i].slot_type == TDD_NR_UPLINK_SLOT;
+    skip = fs->frame_type == TDD && full_ul && !(e && e[0] == '1');
+  }
+  return skip;
+}
+
 int get_first_ul_slot(const frame_structure_t *fs, bool mixed)
 {
   DevAssert(fs);
