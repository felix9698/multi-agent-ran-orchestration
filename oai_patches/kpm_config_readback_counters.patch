+/* Deployment-local configuration readback.  UE attribution is supplied by
+ * KPM Style 4; a zero cap is a valid "uncapped" configuration. */
+static meas_record_lst_t fill_RAN_UE_DlPrbCap(__attribute__((unused)) const label_info_lst_t label,
+                                              __attribute__((unused)) uint32_t gran_period_ms,
+                                              cudu_ue_info_pair_t ue_info,
+                                              __attribute__((unused)) const size_t ue_idx,
+                                              __attribute__((unused)) e2_node_level_stats_t* node_stats)
