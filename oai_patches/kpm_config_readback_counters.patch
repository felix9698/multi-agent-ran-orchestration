+    return no_kpm_config_value();
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  const uint16_t cap = ue_info.ue->UE_sched_ctrl.dl_max_rbSize;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  return (meas_record_lst_t){.value = INTEGER_MEAS_VALUE, .int_val = cap};
+}
+
+static meas_record_lst_t fill_RAN_UE_PfWeight(__attribute__((unused)) const label_info_lst_t label,
+                                              __attribute__((unused)) uint32_t gran_period_ms,
+                                              cudu_ue_info_pair_t ue_info,
+                                              __attribute__((unused)) const size_t ue_idx,
+                                              __attribute__((unused)) e2_node_level_stats_t* node_stats)
+{
+  if (RC.nrmac == NULL || RC.nrmac[0] == NULL || ue_info.ue == NULL)
+    return no_kpm_config_value();
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  const double weight = ue_info.ue->UE_sched_ctrl.pf_weight;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  return (meas_record_lst_t){.value = REAL_MEAS_VALUE, .real_val = weight};
+}
+
+/* Request this measurement twice, once with the standard min label and once
+ * with max.  The scalar KPM record then carries the complete configured pair
+ * without inventing a string encoding. */
+static meas_record_lst_t fill_RAN_Cell_DlMcsBounds(const label_info_lst_t label,
+                                                   __attribute__((unused)) uint32_t gran_period_ms,
+                                                   __attribute__((unused)) cudu_ue_info_pair_t ue_info,
+                                                   __attribute__((unused)) const size_t ue_idx,
+                                                   __attribute__((unused)) e2_node_level_stats_t* node_stats)
+{
+  if (RC.nrmac == NULL || RC.nrmac[0] == NULL || (label.min == NULL) == (label.max == NULL))
+    return no_kpm_config_value();
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  NR_SCHED_LOCK(&mac->sched_lock);
+  const uint32_t bound = label.min != NULL ? mac->dl_bler.min_mcs : mac->dl_bler.max_mcs;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  return (meas_record_lst_t){.value = INTEGER_MEAS_VALUE, .int_val = bound};
+}
+
+/* Style-4 S-NSSAI matching has already selected the UE.  Resolve that UE's
+ * configured logical-channel slice against the atomic Action-6 quota table. */
+static meas_record_lst_t fill_RAN_SlicePrbQuotaMin(__attribute__((unused)) const label_info_lst_t label,
+                                                   __attribute__((unused)) uint32_t gran_period_ms,
+                                                   cudu_ue_info_pair_t ue_info,
+                                                   __attribute__((unused)) const size_t ue_idx,
+                                                   __attribute__((unused)) e2_node_level_stats_t* node_stats)
+{
+  if (RC.nrmac == NULL || RC.nrmac[0] == NULL || ue_info.ue == NULL)
+    return no_kpm_config_value();
+
+  gNB_MAC_INST *mac = RC.nrmac[0];
+  bool found = false;
+  uint32_t minimum = 0;
+  NR_SCHED_LOCK(&mac->sched_lock);
+  const NR_UE_sched_ctrl_t *sched_ctrl = &ue_info.ue->UE_sched_ctrl;
+  for (size_t l = 0; !found && l < seq_arr_size(&sched_ctrl->lc_config); ++l) {
+    const nr_lc_config_t *lc = seq_arr_at(&sched_ctrl->lc_config, l);
+    for (size_t q = 0; q < mac->slice_prb_quotas.count; ++q) {
+      const nr_slice_prb_quota_t *quota = &mac->slice_prb_quotas.entries[q];
+      if (quota->nssai.sst == lc->nssai.sst && quota->nssai.sd == lc->nssai.sd) {
+        minimum = quota->min_ratio;
+        found = true;
+        break;
+      }
+    }
+  }
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  if (!found)
+    return no_kpm_config_value();
+  return (meas_record_lst_t){.value = INTEGER_MEAS_VALUE, .int_val = minimum};
+}
+
+/* distBinX selects one scalar from the three-value device-relative readback:
+ * 1 (or no label) = applied attenuation, 2 = applied absolute gain,
+ * 3 = the live device gain-range maximum. */
+static meas_record_lst_t fill_RAN_Cell_TxAttenuationDb(const label_info_lst_t label,
+                                                       __attribute__((unused)) uint32_t gran_period_ms,
+                                                       __attribute__((unused)) cudu_ue_info_pair_t ue_info,
+                                                       __attribute__((unused)) const size_t ue_idx,
+                                                       __attribute__((unused)) e2_node_level_stats_t* node_stats)
+{
+  if (nr_ru_get_tx_attenuation == NULL)
+    return no_kpm_config_value();
+
+  double configured = 0.0;
+  double applied_gain = 0.0;
+  double range_max = 0.0;
+  if (nr_ru_get_tx_attenuation(&configured, &applied_gain, &range_max) != 0)
+    return no_kpm_config_value();
+
+  const uint16_t component = label.distBinX == NULL ? 1 : *label.distBinX;
+  if (component == 1)
+    return (meas_record_lst_t){.value = REAL_MEAS_VALUE, .real_val = range_max - applied_gain};
+  if (component == 2)
+    return (meas_record_lst_t){.value = REAL_MEAS_VALUE, .real_val = applied_gain};
+  if (component == 3)
+    return (meas_record_lst_t){.value = REAL_MEAS_VALUE, .real_val = range_max};
+  return no_kpm_config_value();
+}
