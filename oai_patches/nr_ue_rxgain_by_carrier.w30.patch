+/* Set the RX gain to an absolute command-line value (the --ue-rxgain scale). */
+void nrue_ru_set_rx_gain(PHY_VARS_NR_UE *UE, double rx_gain)
+{
+  openair0_config_t *cfg0 = &openair0_cfg[UE->rf_map.card];
+  openair0_device_t *dev0 = &openair0_dev[UE->rf_map.card];
+  double was = cfg0->rx_gain[0];
+  cfg0->rx_gain[0] = rx_gain;
+  int ret_gain = dev0->trx_set_gains_func(dev0, cfg0);
+  if (ret_gain < 0) {
+    cfg0->rx_gain[0] += ret_gain;
+    dev0->trx_set_gains_func(dev0, cfg0);
+  }
+  LOG_I(HW, "RX gain set for the new carrier: %.0f -> %.0f\n", was, cfg0->rx_gain[0]);
+}
