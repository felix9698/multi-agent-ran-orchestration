+static bool same_nssai(nssai_t a, nssai_t b)
+{
+  return a.sst == b.sst && a.sd == b.sd;
+}
+
+static void quota_reason(char *reason, size_t reason_len, const char *value)
+{
+  if (reason != NULL && reason_len > 0)
+    snprintf(reason, reason_len, "%s", value);
+}
+
+bool nr_mac_set_slice_prb_quotas(gNB_MAC_INST *mac,
+                                 const nr_slice_prb_quota_t *entries,
+                                 size_t count,
+                                 char *reason,
+                                 size_t reason_len)
+{
+  if (mac == NULL) {
+    quota_reason(reason, reason_len, "MAC instance is absent");
+    return false;
+  }
+  if (count > NR_MAX_SLICE_PRB_QUOTAS || (count > 0 && entries == NULL)) {
+    quota_reason(reason, reason_len, "slice quota table size is invalid");
+    return false;
+  }
+
+  unsigned min_sum = 0;
+  unsigned dedicated_sum = 0;
+  for (size_t i = 0; i < count; ++i) {
+    const nr_slice_prb_quota_t *q = &entries[i];
+    if (q->nssai.sst == 0 || q->nssai.sd > 0xffffff) {
+      quota_reason(reason, reason_len, "S-NSSAI is outside its encoded range");
+      return false;
+    }
+    if (q->dedicated_ratio > q->min_ratio || q->min_ratio > q->max_ratio || q->max_ratio > 100) {
+      quota_reason(reason, reason_len, "quota must satisfy dedicated <= min <= max <= 100");
+      return false;
+    }
+    for (size_t j = 0; j < i; ++j) {
+      if (same_nssai(q->nssai, entries[j].nssai)) {
+        quota_reason(reason, reason_len, "duplicate S-NSSAI in quota table");
+        return false;
+      }
+    }
+    min_sum += q->min_ratio;
+    dedicated_sum += q->dedicated_ratio;
+  }
+  if (min_sum > 100 || dedicated_sum > 100) {
+    quota_reason(reason, reason_len, "aggregate minimum or dedicated ratio exceeds 100");
+    return false;
+  }
+
+  NR_SCHED_LOCK(&mac->sched_lock);
+  uint64_t next_generation = mac->slice_prb_quotas.generation + 1;
+  mac->previous_slice_prb_quotas = mac->slice_prb_quotas;
+  memset(&mac->slice_prb_quotas, 0, sizeof(mac->slice_prb_quotas));
+  mac->slice_prb_quotas.generation = next_generation;
+  mac->slice_prb_quotas.count = count;
+  if (count > 0)
+    memcpy(mac->slice_prb_quotas.entries, entries, count * sizeof(*entries));
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+
+  quota_reason(reason, reason_len, "accepted");
+  return true;
+}
