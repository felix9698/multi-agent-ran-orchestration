+static bool rc_exact_parameter_ids(const seq_ran_param_t* params,
+                                   size_t count,
+                                   const uint32_t* expected,
+                                   size_t expected_count,
+                                   const char** why)
+{
+  if (params == NULL || count != expected_count) {
+    *why = "RAN Parameter membership count mismatch";
+    return false;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    bool known = false;
+    for (size_t j = 0; j < expected_count; ++j)
+      known |= params[i].ran_param_id == expected[j];
+    if (!known) {
+      *why = "unexpected RAN Parameter ID";
+      return false;
+    }
+    for (size_t j = i + 1; j < count; ++j) {
+      if (params[i].ran_param_id == params[j].ran_param_id) {
+        *why = "duplicate RAN Parameter ID";
+        return false;
+      }
+    }
+  }
+  for (size_t i = 0; i < expected_count; ++i) {
+    if (rc_find_ran_param(params, count, expected[i]) == NULL) {
+      *why = "required RAN Parameter ID is absent";
+      return false;
+    }
+  }
+  return true;
+}
+
+static const ran_parameter_value_t* rc_false_element(const seq_ran_param_t* param,
+                                                      ran_parameter_value_e type,
+                                                      const char** why)
+{
+  if (param == NULL || param->ran_param_val.type != ELEMENT_KEY_FLAG_FALSE_RAN_PARAMETER_VAL_TYPE
+      || param->ran_param_val.flag_false == NULL || param->ran_param_val.flag_false->type != type) {
+    *why = "ELEMENT has wrong key flag or value type";
+    return NULL;
+  }
+  return param->ran_param_val.flag_false;
+}
+
+static bool rc_plmn_matches_local(const byte_array_t* value, const char** why)
+{
+  if (value == NULL || value->buf == NULL || value->len != 3 || RC.nrrrc[0] == NULL) {
+    *why = "PLMN Identity is unavailable or not exactly 3 octets";
+    return false;
+  }
+  const uint8_t* b = value->buf;
+  uint8_t mcc1 = b[0] & 0x0f, mcc2 = b[0] >> 4, mcc3 = b[1] & 0x0f;
+  uint8_t mnc3 = b[1] >> 4, mnc1 = b[2] & 0x0f, mnc2 = b[2] >> 4;
+  if (mcc1 > 9 || mcc2 > 9 || mcc3 > 9 || mnc1 > 9 || mnc2 > 9 || (mnc3 > 9 && mnc3 != 0x0f)) {
+    *why = "PLMN Identity contains invalid BCD digits";
+    return false;
+  }
+  plmn_id_t decoded = {
+      .mcc = mcc1 * 100 + mcc2 * 10 + mcc3,
+      .mnc = mnc3 == 0x0f ? mnc1 * 10 + mnc2 : mnc1 * 100 + mnc2 * 10 + mnc3,
+      .mnc_digit_length = mnc3 == 0x0f ? 2 : 3,
+  };
+  plmn_id_t local = RC.nrrrc[0]->configuration.plmn[0];
+  if (decoded.mcc != local.mcc || decoded.mnc != local.mnc || decoded.mnc_digit_length != local.mnc_digit_length) {
+    *why = "RRM Policy Member PLMN does not match this E2 node";
+    return false;
+  }
+  return true;
+}
+
+static bool rc_style2_extract_snssai(const seq_ran_param_t* member,
+                                     size_t member_count, nr_slice_prb_quota_t* quota,
+                                     const char** why)
+{
+  static const uint32_t member_ids[] = {RC_PLMN_IDENTITY, RC_S_NSSAI};
+  if (!rc_exact_parameter_ids(member, member_count, member_ids, 2, why))
+    return false;
+
+  const ran_parameter_value_t* plmn = rc_false_element(
+      rc_find_ran_param(member, 2, RC_PLMN_IDENTITY), OCTET_STRING_RAN_PARAMETER_VALUE, why);
+  if (plmn == NULL || !rc_plmn_matches_local(&plmn->octet_str_ran, why))
+    return false;
+
+  const seq_ran_param_t* snssai = rc_find_ran_param(member, 2, RC_S_NSSAI);
+  if (snssai == NULL || snssai->ran_param_val.type != STRUCTURE_RAN_PARAMETER_VAL_TYPE
+      || snssai->ran_param_val.strct == NULL) {
+    *why = "S-NSSAI is not a STRUCTURE";
+    return false;
+  }
+  const ran_param_struct_t* s = snssai->ran_param_val.strct;
+  static const uint32_t sst_only[] = {RC_SST};
+  static const uint32_t sst_and_sd[] = {RC_SST, RC_SD};
+  if (s->sz_ran_param_struct == 1) {
+    if (!rc_exact_parameter_ids(s->ran_param_struct, s->sz_ran_param_struct, sst_only, 1, why))
+      return false;
+  } else if (s->sz_ran_param_struct == 2) {
+    if (!rc_exact_parameter_ids(s->ran_param_struct, s->sz_ran_param_struct, sst_and_sd, 2, why))
+      return false;
+  } else {
+    *why = "S-NSSAI must contain SST and optional SD";
+    return false;
+  }
+  const ran_parameter_value_t* sst = rc_false_element(
+      rc_find_ran_param(s->ran_param_struct, s->sz_ran_param_struct, RC_SST), OCTET_STRING_RAN_PARAMETER_VALUE, why);
+  const seq_ran_param_t* sd_param = rc_find_ran_param(s->ran_param_struct, s->sz_ran_param_struct, RC_SD);
+  const ran_parameter_value_t* sd = sd_param == NULL ? NULL
+      : rc_false_element(sd_param, OCTET_STRING_RAN_PARAMETER_VALUE, why);
+  if (sst == NULL || sst->octet_str_ran.buf == NULL || sst->octet_str_ran.len != 1
+      || (sd_param != NULL && (sd == NULL || sd->octet_str_ran.buf == NULL || sd->octet_str_ran.len != 3))) {
+    *why = "SST or optional SD has the wrong octet length";
+    return false;
+  }
+  quota->nssai.sst = sst->octet_str_ran.buf[0];
+  quota->nssai.sd = sd == NULL ? 0xffffff
+      : (uint32_t)sd->octet_str_ran.buf[0] << 16
+        | (uint32_t)sd->octet_str_ran.buf[1] << 8
+        | sd->octet_str_ran.buf[2];
+  if (quota->nssai.sst == 0) {
+    *why = "SST zero is not an admitted slice identifier";
+    return false;
+  }
+  return true;
+}
+
+static bool rc_style2_extract_ratio(const seq_ran_param_t* group,
+                                    size_t count,
+                                    uint32_t id,
+                                    uint8_t* out,
+                                    const char** why)
+{
+  const ran_parameter_value_t* value = rc_false_element(
+      rc_find_ran_param(group, count, id), INTEGER_RAN_PARAMETER_VALUE, why);
+  if (value == NULL || value->int_ran < 0 || value->int_ran > 100) {
+    *why = "PRB Policy Ratio is outside 0..100";
+    return false;
+  }
+  *out = value->int_ran;
+  return true;
+}
+
+static bool rc_style2_matches_bootstrap(const nr_slice_prb_quota_t* quotas,
+                                        size_t count,
+                                        const char* configured)
+{
+  if (configured == NULL || count != 1)
+    return false;
+  const nr_slice_prb_quota_t* q = &quotas[0];
+  char canonical[64] = {0};
+  if (q->nssai.sd == 0xffffff)
+    snprintf(canonical, sizeof(canonical), "%u:-:%u:%u:%u",
+             q->nssai.sst, q->min_ratio, q->max_ratio, q->dedicated_ratio);
+  else
+    snprintf(canonical, sizeof(canonical), "%u:%06X:%u:%u:%u",
+             q->nssai.sst, q->nssai.sd, q->min_ratio, q->max_ratio, q->dedicated_ratio);
+  return strcmp(canonical, configured) == 0;
+}
