+
+static unsigned dedicated_ratio_for_other_slices(const gNB_MAC_INST *mac, nssai_t nssai)
+{
+  unsigned reserved = 0;
+  for (size_t i = 0; i < mac->slice_prb_quotas.count; ++i) {
+    const nr_slice_prb_quota_t *quota = &mac->slice_prb_quotas.entries[i];
+    if (!same_nssai(quota->nssai, nssai))
+      reserved += quota->dedicated_ratio;
+  }
+  return reserved;
+}
