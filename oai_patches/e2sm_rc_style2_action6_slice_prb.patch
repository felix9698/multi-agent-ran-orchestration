+  ran_param_type_t* compound = parent->type == LIST_RAN_PARAMETER_DEF_TYPE ? parent->lst : parent->strct;
+  assert(compound != NULL && index < compound->sz_ran_param);
+  ran_param_lst_struct_t* child = &compound->ran_param[index];
+  child->ran_param_id = id;
+  child->ran_param_name = cp_str_to_ba(name);
+  child->ran_param_def = child_definition;
