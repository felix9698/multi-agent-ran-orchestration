+static int active_new_tx_peers(const nr_dl_candidate_t *const *order, int n_active, nssai_t nssai)
+{
+  int peers = 0;
+  for (int j = 0; j < n_active; ++j) {
+    const nr_dl_candidate_t *cand = order[j];
+    if (!cand->is_retx && cand->pending_bytes > 0 && same_nssai(cand->nssai, nssai))
+      ++peers;
+  }
+  return peers;
