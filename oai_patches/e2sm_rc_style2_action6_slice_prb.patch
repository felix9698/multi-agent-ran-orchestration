+      return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, 6, why);
+
+    const seq_ran_param_t* member_list = &policy_struct->ran_param_struct[0];
+    if (member_list->ran_param_val.type != LIST_RAN_PARAMETER_VAL_TYPE || member_list->ran_param_val.lst == NULL
+        || member_list->ran_param_val.lst->sz_lst_ran_param == 0) {
+      return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, 6, "RRM Policy Member List is empty or not a LIST");
+    }
+    const ran_param_list_t* members = member_list->ran_param_val.lst;
