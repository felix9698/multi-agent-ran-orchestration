+    const seq_ran_param_t* policy = rc_find_ran_param(group->ran_param_struct, group->sz_ran_param_struct, RC_RRM_POLICY);
+    if (policy == NULL || policy->ran_param_val.type != STRUCTURE_RAN_PARAMETER_VAL_TYPE
