+    if (!rc_exact_parameter_ids(group->ran_param_struct, group->sz_ran_param_struct, group_ids, 4, &why))
+      return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, 6, why);
