+nr_slice_prb_quota_table_t nr_mac_get_slice_prb_quotas(gNB_MAC_INST *mac)
+{
+  nr_slice_prb_quota_table_t copy = {0};
+  if (mac == NULL)
+    return copy;
+  NR_SCHED_LOCK(&mac->sched_lock);
+  copy = mac->slice_prb_quotas;
+  NR_SCHED_UNLOCK(&mac->sched_lock);
+  return copy;
+}
+
+nr_slice_prb_quota_table_t nr_mac_get_previous_slice_prb_quotas(gNB_MAC_INST *mac)
+{
+  nr_slice_prb_quota_table_t copy = {0};
+  if (mac == NULL)
