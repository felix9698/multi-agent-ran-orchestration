+static sm_ag_if_ans_t rc_ctrl_style_2_slice_prb_quota(const e2sm_rc_ctrl_msg_frmt_1_t* m)
+{
+  const char* why = "";
+  static const uint32_t root_ids[] = {RC_RRM_POLICY_RATIO_LIST};
