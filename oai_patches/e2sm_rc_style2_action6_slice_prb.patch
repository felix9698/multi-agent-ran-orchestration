+static ran_param_def_t* rc_compound_definition(ran_parameter_def_type_e type, size_t child_count)
+{
+  assert(type == LIST_RAN_PARAMETER_DEF_TYPE || type == STRUCTURE_RAN_PARAMETER_DEF_TYPE);
+  assert(child_count > 0);
+  ran_param_def_t* definition = calloc(1, sizeof(*definition));
+  assert(definition != NULL && "Memory exhausted");
+  definition->type = type;
+  ran_param_type_t** compound = type == LIST_RAN_PARAMETER_DEF_TYPE ? &definition->lst : &definition->strct;
+  *compound = calloc(1, sizeof(**compound));
+  assert(*compound != NULL && "Memory exhausted");
+  (*compound)->sz_ran_param = child_count;
+  (*compound)->ran_param = calloc(child_count, sizeof(*(*compound)->ran_param));
+  assert((*compound)->ran_param != NULL && "Memory exhausted");
+  return definition;
+}
