+      || root->ran_param_val.lst->sz_lst_ran_param == 0) {
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, 6, "RRM Policy Ratio List is empty or not a LIST");
+  }
