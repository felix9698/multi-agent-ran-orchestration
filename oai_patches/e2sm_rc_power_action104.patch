diff --git a/executables/nr-ru.c b/executables/nr-ru.c
index e3f3ba9..8fe5652 100644
--- a/executables/nr-ru.c
+++ b/executables/nr-ru.c
@@ -49,6 +49,185 @@ static int DEFRUTPCORES[] = {-1,-1,-1,-1};
 
 static void NRRCconfig_RU(configmodule_interface_t *cfg);
 
+/* Runtime cell-TX attenuation adapter shared by E2SM-RC and the legacy
+ * telnet setup surface.  Keep all config/readback/UHD gain operations under
+ * one process-local lock: UHD does not promise concurrent control-call
+ * safety, and these two callers live on independent pthreads. */
+enum {
+  NR_RU_TX_ATT_OK = 0,
+  NR_RU_TX_ATT_BAD_ARGUMENT = -1,
+  NR_RU_TX_ATT_NOT_READY = -2,
+  NR_RU_TX_ATT_UNSUPPORTED_TOPOLOGY = -3,
+  NR_RU_TX_ATT_NO_READBACK = -4,
+  NR_RU_TX_ATT_OUT_OF_RANGE = -5,
+  NR_RU_TX_ATT_COOLDOWN = -6,
+  NR_RU_TX_ATT_PARTIAL_APPLY = -7,
+  NR_RU_TX_ATT_NO_GAIN_SETTER = -8,
+};
+
+#define NR_RU_TX_ATT_MIN_WRITE_INTERVAL_NS 15000000000LL
+
+static pthread_mutex_t nr_ru_tx_attenuation_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct timespec nr_ru_tx_attenuation_last_write;
+static bool nr_ru_tx_attenuation_has_last_write;
+static double nr_ru_previous_tx_attenuation_db;
+static bool nr_ru_has_previous_tx_attenuation;
+
+static int nr_ru_read_tx_attenuation_locked(double *configured_att_db,
+                                             double *applied_gain_db,
+                                             double *range_max_db)
+{
+  if (configured_att_db == NULL || applied_gain_db == NULL || range_max_db == NULL)
+    return NR_RU_TX_ATT_BAD_ARGUMENT;
+  if (RC.nb_RU < 1 || RC.ru == NULL || RC.ru[0] == NULL)
+    return NR_RU_TX_ATT_NOT_READY;
+
+  RU_t *ru = RC.ru[0];
+  if (ru->nb_tx != 1)
+    return NR_RU_TX_ATT_UNSUPPORTED_TOPOLOGY;
+  if (ru->rfdevice.trx_set_gains_func == NULL || ru->rfdevice.trx_get_tx_gain_func == NULL)
+    return NR_RU_TX_ATT_NO_READBACK;
+
+  double gain = 0.0;
+  double range = 0.0;
+  if (ru->rfdevice.trx_get_tx_gain_func(&ru->rfdevice, 0, &gain, &range) != 0
+      || !isfinite(gain) || !isfinite(range) || range < 0.0)
+    return NR_RU_TX_ATT_NO_READBACK;
+
+  *configured_att_db = ru->openair0_cfg.tx_gain[0];
+  *applied_gain_db = gain;
+  *range_max_db = range;
+  return NR_RU_TX_ATT_OK;
+}
+
+int nr_ru_get_tx_attenuation(double *configured_att_db,
+                             double *applied_gain_db,
+                             double *range_max_db)
+{
+  pthread_mutex_lock(&nr_ru_tx_attenuation_mutex);
+  const int rc = nr_ru_read_tx_attenuation_locked(configured_att_db, applied_gain_db, range_max_db);
+  pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+  return rc;
+}
+
+int nr_ru_get_previous_tx_attenuation(double *previous_att_db)
+{
+  if (previous_att_db == NULL)
+    return NR_RU_TX_ATT_BAD_ARGUMENT;
+  pthread_mutex_lock(&nr_ru_tx_attenuation_mutex);
+  if (!nr_ru_has_previous_tx_attenuation) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_NOT_READY;
+  }
+  *previous_att_db = nr_ru_previous_tx_attenuation_db;
+  pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+  return NR_RU_TX_ATT_OK;
+}
+
+static int64_t nr_ru_timespec_delta_ns(const struct timespec *newer, const struct timespec *older)
+{
+  return (int64_t)(newer->tv_sec - older->tv_sec) * 1000000000LL + newer->tv_nsec - older->tv_nsec;
+}
+
+int nr_ru_set_tx_attenuation(double att_db,
+                             double *applied_gain_db,
+                             double *range_max_db)
+{
+  if (!isfinite(att_db) || applied_gain_db == NULL || range_max_db == NULL)
+    return NR_RU_TX_ATT_BAD_ARGUMENT;
+
+  pthread_mutex_lock(&nr_ru_tx_attenuation_mutex);
+
+  double configured = 0.0;
+  double prior_gain = 0.0;
+  double range = 0.0;
+  int rc = nr_ru_read_tx_attenuation_locked(&configured, &prior_gain, &range);
+  if (rc != NR_RU_TX_ATT_OK) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return rc;
+  }
+  if (att_db < 0.0 || att_db > range) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_OUT_OF_RANGE;
+  }
+
+  struct timespec now = {0};
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_NOT_READY;
+  }
+  if (nr_ru_tx_attenuation_has_last_write
+      && nr_ru_timespec_delta_ns(&now, &nr_ru_tx_attenuation_last_write) < NR_RU_TX_ATT_MIN_WRITE_INTERVAL_NS) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_COOLDOWN;
+  }
+
+  /* The live hardware value, not the last commanded config value, is the
+   * restorable predecessor. */
+  nr_ru_previous_tx_attenuation_db = range - prior_gain;
+  nr_ru_has_previous_tx_attenuation = true;
+
+  RU_t *ru = RC.ru[0];
+  ru->openair0_cfg.tx_gain[0] = att_db;
+  const int set_rc = ru->rfdevice.trx_set_gains_func(&ru->rfdevice, &ru->openair0_cfg);
+  nr_ru_tx_attenuation_last_write = now;
+  nr_ru_tx_attenuation_has_last_write = true;
+
+  double ignored_configured = 0.0;
+  const int read_rc = nr_ru_read_tx_attenuation_locked(&ignored_configured, applied_gain_db, range_max_db);
+  pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+  if (read_rc != NR_RU_TX_ATT_OK)
+    return read_rc;
+
+  /* trx_usrp_set_gains() applies TX before its RX-range check.  A non-zero
+   * result is therefore a reported partial apply, never an ACK. */
+  return set_rc == 0 ? NR_RU_TX_ATT_OK : NR_RU_TX_ATT_PARTIAL_APPLY;
+}
+
+/* Legacy `ci rfatt` lab surface.  Same mutex as the E2 path, so the two
+ * writers serialise, but none of the Action-104 policy: no cooldown, no live
+ * device-range bound, no coerced readback, and no dependency on
+ * trx_get_tx_gain_func -- only the USRP driver supplies one, while ten other
+ * radio backends supply trx_set_gains_func alone.  Those corrections belong to
+ * Action 104; `ci rfatt` is a frozen surface whose grammar tooling parses. */
+int nr_ru_lab_get_tx_attenuation(double *configured_att_db)
+{
+  if (configured_att_db == NULL)
+    return NR_RU_TX_ATT_BAD_ARGUMENT;
+  pthread_mutex_lock(&nr_ru_tx_attenuation_mutex);
+  if (RC.nb_RU < 1 || RC.ru == NULL || RC.ru[0] == NULL) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_NOT_READY;
+  }
+  *configured_att_db = RC.ru[0]->openair0_cfg.tx_gain[0];
+  pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+  return NR_RU_TX_ATT_OK;
+}
+
+int nr_ru_lab_set_tx_attenuation(double att_db)
+{
+  if (!isfinite(att_db))
+    return NR_RU_TX_ATT_BAD_ARGUMENT;
+  pthread_mutex_lock(&nr_ru_tx_attenuation_mutex);
+  if (RC.nb_RU < 1 || RC.ru == NULL || RC.ru[0] == NULL) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_NOT_READY;
+  }
+  RU_t *ru = RC.ru[0];
+  if (ru->rfdevice.trx_set_gains_func == NULL) {
+    pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+    return NR_RU_TX_ATT_NO_GAIN_SETTER;
+  }
+  /* The Action-104 rollback baseline is deliberately not updated here: it
+   * holds a hardware-truth quantity this knob cannot produce.  A gNB restart
+   * remains the documented undo for a telnet-applied value. */
+  for (int i = 0; i < ru->nb_tx && i < 8; ++i)
+    ru->openair0_cfg.tx_gain[i] = att_db;
+  ru->rfdevice.trx_set_gains_func(&ru->rfdevice, &ru->openair0_cfg);
+  pthread_mutex_unlock(&nr_ru_tx_attenuation_mutex);
+  return NR_RU_TX_ATT_OK;
+}
+
