+  if (set_rc == NR_RU_TX_ATT_PARTIAL_APPLY)
+    return rc_ctrl_reject(RC_CTRL_REJ_CAPABILITY_STATE,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
