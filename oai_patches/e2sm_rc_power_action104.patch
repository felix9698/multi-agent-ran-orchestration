+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
+                          read_rc == NR_RU_TX_ATT_UNSUPPORTED_TOPOLOGY
+                              ? "runtime TX attenuation requires exactly one TX chain"
+                              : "RF gain or hardware readback is not ready");
+  if (att_db < 0.0 || att_db > range_max)
