+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT, 2, RC_ACTION_104_CELL_DL_TX_POWER, why);
+
+  const seq_ran_param_t* att_param = rc_find_ran_param(
+      power->ran_param_struct, power->sz_ran_param_struct, RC_DL_TX_ATTENUATION_DB);
+  if (att_param == NULL
+      || att_param->ran_param_val.type != ELEMENT_KEY_FLAG_FALSE_RAN_PARAMETER_VAL_TYPE
+      || att_param->ran_param_val.flag_false == NULL)
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
+                          "DL TX Attenuation dB has wrong key flag or is absent");
+
+  const ran_parameter_value_t* att_value = att_param->ran_param_val.flag_false;
+  double att_db = 0.0;
+  if (att_value->type == REAL_RAN_PARAMETER_VALUE)
+    att_db = att_value->real_ran;
+  else if (att_value->type == INTEGER_RAN_PARAMETER_VALUE)
+    att_db = att_value->int_ran;
+  else
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
+                          "DL TX Attenuation dB is not a REAL or INTEGER");
+  if (!isfinite(att_db))
+    return rc_ctrl_reject(RC_CTRL_REJ_PROTOCOL_CONTRACT,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
+                          "DL TX Attenuation dB is not finite");
+
+  const ran_parameter_value_t* target = rc_false_element(
+      rc_find_ran_param(power->ran_param_struct, power->sz_ran_param_struct, RC_TARGET_GNB_ID),
+      INTEGER_RAN_PARAMETER_VALUE,
