+                          "DL TX Attenuation dB is outside the live device range");
+
+  const int set_rc = nr_ru_set_tx_attenuation(att_db, &applied_gain, &range_max);
+  if (set_rc == NR_RU_TX_ATT_COOLDOWN)
+    return rc_ctrl_reject(RC_CTRL_REJ_POLICY_OR_ADMISSION,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
+                          "minimum 15000 ms RF write interval has not elapsed");
+  if (set_rc == NR_RU_TX_ATT_OUT_OF_RANGE)
+    return rc_ctrl_reject(RC_CTRL_REJ_POLICY_OR_ADMISSION,
+                          2,
+                          RC_ACTION_104_CELL_DL_TX_POWER,
