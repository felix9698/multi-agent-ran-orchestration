+static sm_ag_if_ans_t rc_ctrl_style_2_cell_tx_power(const e2sm_rc_ctrl_msg_frmt_1_t* m)
+{
+  const char* why = "";
+  const ran_param_struct_t* power = rc_style2_structure_root(m, RC_CELL_DL_TX_POWER, &why);
+  static const uint32_t child_ids[] = {RC_DL_TX_ATTENUATION_DB, RC_TARGET_GNB_ID};
