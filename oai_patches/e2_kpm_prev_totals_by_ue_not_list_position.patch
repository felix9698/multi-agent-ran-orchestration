 static uldlcounter_t last_pdcp_sdu_total_bytes[MAX_MOBILES_PER_GNB] = {0};
 
+/* 2026-09-24: the previous-period totals were kept by ue_idx, the UE's position in THIS
+   indication's list.  gnb2 sends one indication per UE (one UE per list), so every UE was
+   ue_idx 0 and two UEs overwrote one slot: each reported "its total minus the other UE's
+   total" (ue1 + ue3 summed to a constant while real traffic moved).  Key the slot by the
+   MAC uid instead, and re-baseline (report 0 once) when the slot's owner RNTI changes. */
+enum { KPM_F_PDCP_DL = 1, KPM_F_PDCP_UL = 2, KPM_F_RLC_DL = 4, KPM_F_RLC_UL = 8, KPM_F_PRB_DL = 16, KPM_F_PRB_UL = 32 };
+static uint16_t kpm_slot_rnti[MAX_MOBILES_PER_GNB];
+static uint8_t kpm_slot_seen[MAX_MOBILES_PER_GNB];
+
+static size_t kpm_ue_slot(cudu_ue_info_pair_t ue_info, size_t ue_idx)
+{
+  if (ue_info.ue == NULL || ue_info.ue->uid >= MAX_MOBILES_PER_GNB)
+    return ue_idx;
+  const size_t s = ue_info.ue->uid;
+  if (kpm_slot_rnti[s] != ue_info.ue->rnti) {
+    kpm_slot_rnti[s] = ue_info.ue->rnti;
+    kpm_slot_seen[s] = 0;
+  }
+  return s;
+}
+
+/* true the first time this measurement is read for the slot's current owner */
+static bool kpm_first_read(size_t s, uint8_t flag)
+{
+  if (s >= MAX_MOBILES_PER_GNB || (kpm_slot_seen[s] & flag))
+    return false;
+  kpm_slot_seen[s] |= flag;
+  return true;
+}
